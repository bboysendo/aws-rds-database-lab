variable "aws_region" {
  description = "AWS region to deploy into."
  type        = string
  default     = "us-east-1"
}

variable "project_name" {
  description = "Short name used as a prefix/tag for all resources."
  type        = string
  default     = "rds-lab"
}

variable "engine_version" {
  description = "MySQL engine version."
  type        = string
  default     = "8.0"
}

variable "instance_class" {
  description = "RDS instance class. db.t3.micro is Free-Tier eligible on new accounts."
  type        = string
  default     = "db.t3.micro"
}

variable "allocated_storage_gb" {
  description = "Allocated storage in GB. 20 GB is within the Free Tier."
  type        = number
  default     = 20
}

variable "multi_az" {
  description = "Enable Multi-AZ synchronous standby. NOT Free-Tier eligible and roughly doubles cost — see README."
  type        = bool
  default     = false
}

variable "backup_retention_days" {
  description = "Number of days to retain automated backups."
  type        = number
  default     = 7
}

variable "master_username" {
  description = "Master username for the database (the password is auto-generated by RDS into Secrets Manager — never set here)."
  type        = string
  default     = "admin"
}
